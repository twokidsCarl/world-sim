{
  "title": "Contract",
  "type": "object",
  "$defs": {
    "Beat": {
      "properties": {
        "what": {
          "type": "string"
        },
        "who": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "what"
      ],
      "type": "object"
    },
    "Case": {
      "description": "一个可以拿来做输入和校准的故事：谁、什么关系、依次发生了什么。\nA story that can serve as input and as a calibration case: who was involved, how they were related, and what happened in what order.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "type": "array"
        },
        "kind": {
          "enum": [
            "drama",
            "novel",
            "idiom",
            "history"
          ],
          "type": "string"
        },
        "setting": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "people": {
          "items": {
            "$ref": "#/$defs/Character"
          },
          "type": "array"
        },
        "events": {
          "description": "原作或史料里的事件顺序 / the order of events in the source text or historical record",
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "type": "array"
        },
        "outcome": {
          "description": "结局；模拟要复现的就是它 / the outcome; this is what the simulation has to reproduce",
          "type": "string"
        },
        "theories": {
          "description": "这个故事体现了哪些理论卡，写 id / ids of the theory cards this story illustrates",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "sources",
        "kind",
        "setting",
        "summary",
        "people",
        "events",
        "outcome",
        "theories"
      ],
      "type": "object"
    },
    "Character": {
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "traits": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "name",
        "role"
      ],
      "type": "object"
    },
    "District": {
      "properties": {
        "idx": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "pos": {
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        },
        "radius": {
          "type": "number"
        }
      },
      "required": [
        "idx",
        "name",
        "pos",
        "radius"
      ],
      "type": "object"
    },
    "Event": {
      "description": "events.jsonl 的一行。键名取短，因为行数很多。\nOne line of events.jsonl. Keys are short because there are a great many lines.",
      "properties": {
        "t": {
          "type": "integer"
        },
        "k": {
          "enum": [
            "seed",
            "tell",
            "mutate",
            "queue",
            "withdraw",
            "verify",
            "broadcast",
            "intervene",
            "fail",
            "thought"
          ],
          "type": "string"
        },
        "a": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "行动者 / actor"
        },
        "b": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "对象 / target"
        },
        "m": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "消息 id / message id"
        },
        "via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "关系类型，或 venue:<idx> / tie kind, or venue:<idx>"
        },
        "p0": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "对象事前信念，百分数 / target's belief beforehand, in percent"
        },
        "p1": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "对象事后信念，百分数 / target's belief afterwards, in percent"
        },
        "x": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "文本或金额 / text or amount"
        }
      },
      "required": [
        "t",
        "k"
      ],
      "type": "object"
    },
    "Fact": {
      "description": "一条典型事实：研究里反复出现、模拟应当复现的定量或定性规律。\nA stylised fact: a quantitative or qualitative regularity that recurs in the research and that the simulation should reproduce.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "type": "array"
        },
        "statement": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "quantitative",
            "qualitative"
          ],
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
              "items": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "default": "",
          "type": "string"
        },
        "conditions": {
          "description": "这个结果是在什么条件下得到的 / the conditions under which this result was obtained",
          "type": "string"
        },
        "caveats": {
          "default": "",
          "description": "复现争议、适用范围 / replication disputes and limits of applicability",
          "type": "string"
        },
        "theories": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "metric": {
          "default": "",
          "description": "polis 里对应的可计算指标；留空表示尚未定义 / the corresponding computable metric in polis; empty means not yet defined",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "sources",
        "statement",
        "kind",
        "conditions"
      ],
      "type": "object"
    },
    "Intervention": {
      "description": "对模拟世界的一次外部干预。/ One outside intervention in the simulated world.",
      "properties": {
        "t": {
          "type": "integer"
        },
        "kind": {
          "default": "broadcast",
          "enum": [
            "broadcast",
            "close_venue",
            "silence",
            "convince",
            "insurance"
          ],
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "broadcast：出面的人 / broadcast: the person who makes the announcement"
        },
        "target": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "close_venue：场所下标；silence / convince：人的下标 / close_venue: venue index; silence and convince: person index"
        },
        "text": {
          "default": "",
          "type": "string"
        },
        "valence": {
          "default": -1,
          "enum": [
            1,
            -1
          ],
          "type": "integer"
        },
        "strength": {
          "default": 1.5,
          "type": "number"
        },
        "reach": {
          "default": 0.5,
          "description": "broadcast：触达的人口比例 / broadcast: share of the population reached",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "duration": {
          "default": 0,
          "description": "close_venue：关几个小时，0 为一直关 / close_venue: hours closed; 0 means closed for good",
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "default": 0.0,
          "description": "insurance：存款保险赔付比例 / insurance: share of a lost deposit that is paid back",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "t"
      ],
      "type": "object"
    },
    "Manifest": {
      "properties": {
        "schema": {
          "default": 1,
          "type": "integer"
        },
        "run_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "setting": {
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/Params"
        },
        "n": {
          "type": "integer"
        },
        "ticks": {
          "type": "integer"
        },
        "channels": {
          "default": [
            "belief",
            "fear",
            "expect",
            "status"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "branch_t": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        }
      },
      "required": [
        "run_id",
        "title",
        "setting",
        "params",
        "n",
        "ticks",
        "summary"
      ],
      "type": "object"
    },
    "Message": {
      "description": "一条说法。转述变形时产生子消息，parent 连成谱系。\nOne version of the story. When it changes in the retelling a child message is created; the parent links form its lineage.",
      "properties": {
        "id": {
          "type": "integer"
        },
        "parent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "t": {
          "type": "integer"
        },
        "author": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "valence": {
          "description": "1 谣言，-1 辟谣 / 1 rumour, -1 correction",
          "enum": [
            1,
            -1
          ],
          "type": "integer"
        },
        "severity": {
          "type": "number"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "t",
        "valence",
        "severity",
        "text"
      ],
      "type": "object"
    },
    "Parameter": {
      "properties": {
        "name": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "meaning"
      ],
      "type": "object"
    },
    "Params": {
      "description": "一次运行的全部可调参数。相同参数必须产生相同记录。\nEvery tunable parameter of a run. The same parameters must produce the same record.",
      "properties": {
        "scenario": {
          "default": "rumor_run",
          "type": "string"
        },
        "seed": {
          "default": 1,
          "type": "integer"
        },
        "n": {
          "default": 1000,
          "type": "integer"
        },
        "ticks": {
          "default": 96,
          "type": "integer"
        },
        "start_hour": {
          "default": 20,
          "type": "integer"
        },
        "prior": {
          "default": 0.03,
          "type": "number"
        },
        "w_tell": {
          "default": 2.6,
          "type": "number"
        },
        "w_seen": {
          "default": 3.0,
          "type": "number"
        },
        "novelty": {
          "default": 0.6,
          "type": "number"
        },
        "corroborate": {
          "default": 0.5,
          "type": "number"
        },
        "confirm": {
          "default": 0.4,
          "type": "number"
        },
        "forget": {
          "default": 0.01,
          "type": "number"
        },
        "share": {
          "default": 0.16,
          "type": "number"
        },
        "stifle": {
          "default": 0.93,
          "type": "number"
        },
        "mutate": {
          "default": 0.08,
          "type": "number"
        },
        "venue_share": {
          "default": 0.25,
          "type": "number"
        },
        "venue_audience": {
          "default": 3,
          "type": "integer"
        },
        "verify": {
          "default": 0.02,
          "type": "number"
        },
        "w_verify": {
          "default": 2.5,
          "type": "number"
        },
        "cost": {
          "default": 0.12,
          "type": "number"
        },
        "lam": {
          "default": 12.0,
          "type": "number"
        },
        "bias": {
          "default": -5.0,
          "type": "number"
        },
        "hazard": {
          "default": 0.3,
          "type": "number"
        },
        "perceived_reserve": {
          "default": 0.35,
          "type": "number"
        },
        "reserve_ratio": {
          "default": 0.3,
          "type": "number"
        },
        "tellers": {
          "default": 0.02,
          "type": "number"
        },
        "interventions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Intervention"
          },
          "type": "array"
        },
        "llm": {
          "default": false,
          "description": "主角是否交给大模型扮演 / whether the model plays the protagonists",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Person": {
      "description": "一个人的静态表征；随时间变化的心智状态在帧里。\nThe static description of one person; the mental state that changes over time lives in the frames.",
      "properties": {
        "idx": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "protagonist": {
          "default": false,
          "type": "boolean"
        },
        "role": {
          "default": "",
          "type": "string"
        },
        "persona": {
          "default": "",
          "type": "string"
        },
        "age": {
          "type": "integer"
        },
        "sex": {
          "enum": [
            "f",
            "m"
          ],
          "type": "string"
        },
        "education": {
          "description": "0 不识字 1 蒙学 2 中学 3 高等 / 0 illiterate, 1 elementary, 2 secondary, 3 higher",
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        "income": {
          "description": "收入分位 / income quantile",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "trust_general": {
          "type": "number"
        },
        "trust_institution": {
          "type": "number"
        },
        "risk_aversion": {
          "type": "number"
        },
        "conformity": {
          "type": "number"
        },
        "media_use": {
          "type": "number"
        },
        "depth": {
          "description": "揣度他人的层数 k / k, how many levels deep this person reasons about others",
          "maximum": 2,
          "minimum": 0,
          "type": "integer"
        },
        "deposit": {
          "description": "存款，单位：元 / deposit, in yuan",
          "type": "number"
        },
        "stake": {
          "description": "这笔存款对他有多要紧 / how much this deposit matters to them",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "household": {
          "type": "integer"
        },
        "district": {
          "type": "integer"
        },
        "workplace": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "venues": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "pos": {
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "idx",
        "name",
        "age",
        "sex",
        "education",
        "income",
        "trust_general",
        "trust_institution",
        "risk_aversion",
        "conformity",
        "media_use",
        "depth",
        "deposit",
        "stake",
        "household",
        "district",
        "pos"
      ],
      "type": "object"
    },
    "Population": {
      "properties": {
        "schema": {
          "default": 1,
          "type": "integer"
        },
        "synthetic": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "extent": {
          "description": "坐标范围 [0, extent] / coordinates run over [0, extent]",
          "type": "number"
        },
        "bank": {
          "description": "钱庄在 venues 里的下标 / index of the bank in venues",
          "type": "integer"
        },
        "cast": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "主角的角色键 → persons 下标 / protagonist role key → index into persons",
          "type": "object"
        },
        "persons": {
          "items": {
            "$ref": "#/$defs/Person"
          },
          "type": "array"
        },
        "ties": {
          "items": {
            "$ref": "#/$defs/Tie"
          },
          "type": "array"
        },
        "venues": {
          "items": {
            "$ref": "#/$defs/Venue"
          },
          "type": "array"
        },
        "districts": {
          "items": {
            "$ref": "#/$defs/District"
          },
          "type": "array"
        }
      },
      "required": [
        "synthetic",
        "note",
        "extent",
        "bank",
        "cast",
        "persons",
        "ties",
        "venues",
        "districts"
      ],
      "type": "object"
    },
    "Series": {
      "description": "每个 tick 的宏观量，长度都是 ticks + 1。\nAggregate quantities per tick; every list has length ticks + 1.",
      "properties": {
        "aware": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "believers": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "queue": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "withdrew": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "reserve": {
          "description": "钱庄现银占初始存款的比例 / the bank's cash as a share of initial deposits",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "fear": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "aware",
        "believers",
        "queue",
        "withdrew",
        "reserve",
        "fear"
      ],
      "type": "object"
    },
    "Source": {
      "description": "一条出处。verified 只有在打开过能证实它的页面之后才能为真，checked 写明看的是哪一页、证实了什么。\nOne source. verified may be true only after someone has opened a page that confirms it; checked records which page that was and what it confirmed.",
      "properties": {
        "work": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "locator": {
          "default": "",
          "description": "期刊卷期页码、章回、幕次 / journal volume, issue and pages; chapter; act and scene",
          "type": "string"
        },
        "url": {
          "default": "",
          "type": "string"
        },
        "verified": {
          "default": false,
          "type": "boolean"
        },
        "checked": {
          "default": "",
          "description": "核实方式：哪个页面证实了哪些信息 / how it was verified: which page confirmed what",
          "type": "string"
        }
      },
      "required": [
        "work",
        "author"
      ],
      "type": "object"
    },
    "Summary": {
      "properties": {
        "peak_believers": {
          "type": "integer"
        },
        "withdrew": {
          "type": "integer"
        },
        "lost": {
          "type": "integer"
        },
        "failed_at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "messages": {
          "type": "integer"
        },
        "events": {
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "type": "integer"
        },
        "llm_failed": {
          "default": 0,
          "type": "integer"
        }
      },
      "required": [
        "peak_believers",
        "withdrew",
        "lost",
        "failed_at",
        "messages",
        "events"
      ],
      "type": "object"
