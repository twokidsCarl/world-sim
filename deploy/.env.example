# 复制成 deploy/.env 再填。.env 不进 git。
# Copy to deploy/.env and fill in. The .env file never goes into git.

# idea-loom 自己的域名，和模拟挂在哪个域名下。两条 DNS 记录都指向这台主机：
#   HUB_DOMAIN        A 记录
#   *.SIM_DOMAIN      通配 A 记录
# idea-loom's own domain, and the domain simulations hang under. Point both at this host:
# an A record for HUB_DOMAIN and a wildcard A record for *.SIM_DOMAIN.
HUB_DOMAIN=loom.example.com
SIM_DOMAIN=sim.example.com
ACME_EMAIL=you@example.com

# 仓库地址（公开仓库，用 https 即可）/ the repository (public, so https is enough)
REPO_URL=https://github.com/twokidsCarl/world-sim.git

# hub 和 play 之间内部接口的口令。随便生成一个长的：openssl rand -hex 32
# Shared token for the internal API between hub and play: openssl rand -hex 32
INTERNAL_TOKEN=

# 主人的 GitHub 用户名。只有这个账号登录后能改动、能调用模型；必须填，不填 hub 不启动
# （不填的话程序会当成本地模式，人人都是主人）。
# The owner's GitHub login. Only this account, once signed in, may change things or call the
# model. Required: the hub will not start without it (unset would mean local mode, where
# everyone is the owner).
OWNER_GITHUB=

# GitHub OAuth 应用（Settings → Developer settings → OAuth Apps → New）。
# 回调地址填 https://<HUB_DOMAIN>/auth/callback
# A GitHub OAuth app (Settings → Developer settings → OAuth Apps → New), with the callback
# URL set to https://<HUB_DOMAIN>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 给登录 cookie 签名的密钥：openssl rand -hex 32。换掉它，所有人都要重新登录。
# The key that signs the sign-in cookie: openssl rand -hex 32. Changing it signs everyone out.
SESSION_SECRET=

# 只给 worker。在自己的电脑上运行 claude setup-token 得到，一年有效。
# 这台主机的环境里不要设 ANTHROPIC_API_KEY，否则订阅会被绕过去。
# For the worker only. Run `claude setup-token` on your own computer; valid for a year.
# Do not set ANTHROPIC_API_KEY anywhere on this host, or the subscription is bypassed.
CLAUDE_CODE_OAUTH_TOKEN=

# 只给 worker。一个只对这一个仓库有"内容读写 + 合并请求读写"权限的细粒度令牌。
# For the worker only. A fine-grained token limited to this one repository with
# contents read/write and pull requests read/write.
GH_TOKEN=

# worker 提交时用的名字和邮箱（会出现在公开仓库的提交记录里）。
# The name and email the worker commits with (they appear in the public repository's history).
GIT_NAME=
GIT_EMAIL=

# 闸门：每天最多开工几个作业；订阅额度用到多少（0 到 1）就暂停，等窗口过去。
# Gates: how many jobs may start per day, and the allowance utilisation (0 to 1) at which
# the queue pauses until the window resets.
JOBS_PER_DAY=6
USAGE_PAUSE=0.8

# 数据库的连续备份（可选，但上线后应该开）。任何兼容 S3 的对象存储都行。
# 用 --profile backup 启动 backup 容器。
# Continuous backup of the database (optional, but turn it on once you go live). Any
# S3-compatible object storage works. Start the backup container with --profile backup.
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_REGION=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=

# 推送通知（可选）。生成一对密钥：docker compose -f deploy/compose.yaml run --rm hub idea-loom push keys
# 填好后重启，在界面左下角（手机上是底栏最右边）点"通知"。
# Push notifications (optional). Generate a key pair with the command above, fill these in,
# restart, then tap "Alerts" at the bottom left of the UI (far right of the bottom bar on a phone).
VAPID_PUBLIC=
VAPID_PRIVATE=

# 自动维护：提交少的时候自动做一件还技术债的小事。默认关；设成 1 才开。
# 不是每晚定时：worker 每 MAINTENANCE_CHECK 秒看一次 main 上最近 MAINTENANCE_WINDOW 分钟的提交数，
# 少于 MAINTENANCE_BELOW 次、又没有别的作业，就开一次。两次之间至少隔 MAINTENANCE_GAP 秒，
# 每天最多 MAINTENANCE_PER_DAY 次（它们也算在 JOBS_PER_DAY 里）。
# Automatic maintenance: one small piece of technical-debt work when commits are few. Off by
# default; 1 turns it on. It is not a nightly schedule: every MAINTENANCE_CHECK seconds the
# worker counts the commits on main in the last MAINTENANCE_WINDOW minutes and starts a run
# when there are fewer than MAINTENANCE_BELOW and no other job. Runs are at least
# MAINTENANCE_GAP seconds apart and at most MAINTENANCE_PER_DAY a day (they also count
# towards JOBS_PER_DAY).
MAINTENANCE=0
MAINTENANCE_CHECK=300
MAINTENANCE_WINDOW=60
MAINTENANCE_BELOW=2
MAINTENANCE_GAP=1800
MAINTENANCE_PER_DAY=4
