# 复制成 deploy/.env 再填。.env 不进 git。
# Copy to deploy/.env and fill in. The .env file never goes into git.

# idea-loom 自己的域名，和模拟挂在哪个域名下。两条 DNS 记录都指向这台主机：
#   HUB_DOMAIN        A 记录
#   *.SIM_DOMAIN      通配 A 记录
# idea-loom's own domain, and the domain simulations hang under. Point both at this host:
# an A record for HUB_DOMAIN and a wildcard A record for *.SIM_DOMAIN.
HUB_DOMAIN=loom.example.com
SIM_DOMAIN=sim.example.com
ACME_EMAIL=you@example.com

# 仓库地址（公开仓库，用 https 即可）/ the repository (public, so https is enough)
REPO_URL=https://github.com/twokidsCarl/world-sim.git

# hub 和 play 之间内部接口的口令。随便生成一个长的：openssl rand -hex 32
# Shared token for the internal API between hub and play: openssl rand -hex 32
INTERNAL_TOKEN=

# 登录做好之前的临时口令。哈希用这个生成：docker run --rm caddy:2 caddy hash-password
# The temporary gate until sign-in exists. Make the hash with: docker run --rm caddy:2 caddy hash-password
GATE_USER=owner
GATE_HASH=

# 只给 worker。在自己的电脑上运行 claude setup-token 得到，一年有效。
# 这台主机的环境里不要设 ANTHROPIC_API_KEY，否则订阅会被绕过去。
# For the worker only. Run `claude setup-token` on your own computer; valid for a year.
# Do not set ANTHROPIC_API_KEY anywhere on this host, or the subscription is bypassed.
CLAUDE_CODE_OAUTH_TOKEN=

# 只给 worker。一个只对这一个仓库有"内容读写 + 合并请求读写"权限的细粒度令牌。
# For the worker only. A fine-grained token limited to this one repository with
# contents read/write and pull requests read/write.
GH_TOKEN=
