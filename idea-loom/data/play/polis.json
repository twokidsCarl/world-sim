{
  "title": {
    "zh": "平行社会",
    "en": "A parallel society"
  },
  "level": "L8",
  "ready": true,
  "web": {
    "dir": "web",
    "build": [
      [
        "bun",
        "install"
      ],
      [
        "bunx",
        "vite",
        "build"
      ]
    ],
    "dist": "dist"
  },
  "api": {
    "dir": ".",
    "prepare": [
      [
        "uv",
        "sync"
      ]
    ],
    "run": [
      "uv",
      "run",
      "uvicorn",
      "polis.server:app",
      "--host",
      "127.0.0.1",
      "--port",
      "{port}",
      "--log-level",
      "warning"
    ],
    "health": "/api/runs",
    "env": {
      "POLIS_RUNS": "{repo}/polis/runs"
    }
  },
  "cards": [
    {
      "id": "default",
      "title": {
        "zh": "一次银行挤兑的回放",
        "en": "Replay of a bank run"
      },
      "hint": {
        "zh": "按空格播放。一座城里，看谣言怎么传、队怎么排起来；右上角可以换另一次运行",
        "en": "Press space to play. Watch a rumour spread through a town and the queue form; switch to another run at the top right"
      },
      "idea": null,
      "url": "/"
    }
  ]
}
