    "lateralmalleolusheight": 1
   }
  },
  {
   "id": "foot",
   "name": {
    "zh": "足长",
    "en": "Foot length"
   },
   "lengthMm": {
    "footlength": 1
   }
  },
  {
   "id": "upperArm",
   "name": {
    "zh": "上臂",
    "en": "Upper arm"
   },
   "lengthMm": {
    "acromionradialelength": 1
   }
  },
  {
   "id": "forearm",
   "name": {
    "zh": "前臂",
    "en": "Forearm"
   },
   "lengthMm": {
    "radialestylionlength": 1
   }
  },
  {
   "id": "hand",
   "name": {
    "zh": "手长",
