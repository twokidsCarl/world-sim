{
 "schema": 1,
 "description": {
  "zh": "体型模型方案（Rig.shape 的建议内容）。控制量经人体测量模型换算成各肢段长度、各部位围度和皮下脂肪厚度；运行时取相对静止值的比值。详见 tools/bodyshape/REPORT.md。",
  "en": "Proposed body-shape model (what Rig.shape would hold). Controls are turned into segment lengths, girths and subcutaneous-fat thickness through the anthropometric model; the runtime uses ratios to the rest values. See tools/bodyshape/REPORT.md."
 },
 "controls": [
  {
   "id": "stature",
   "name": {
    "zh": "身高",
    "en": "Stature"
   },
   "unit": "m",
   "min": 1.4,
   "max": 2.0,
   "rest": {
    "F": 1.67,
    "M": 1.72
   }
  },
  {
   "id": "bmi",
   "name": {
    "zh": "体重指数（胖瘦）",
    "en": "Body-mass index (fatness)"
   },
   "unit": "kg/m2",
   "min": 16,
   "max": 40,
   "rest": {
    "F": null,
    "M": 23.9
   },
   "note": {
    "zh": "男性静止值由皮肤体积得出；女性取决于换用哪张皮肤（参考体表为 22）",
    "en": "male rest value from the skin volume; female depends on the skin adopted (22 for the reference surface)"
   }
  },
  {
   "id": "legLength",
   "name": {
    "zh": "腿长比例",
    "en": "Relative leg length"
   },
   "unit": "sd",
   "min": -2,
   "max": 2,
   "rest": {
    "F": 0,
    "M": 0
   }
  },
  {
   "id": "centralBuild",
   "name": {
    "zh": "体型分布（腰腹型–四肢型）",
    "en": "Mass distribution (waist-heavy vs limb-heavy)"
   },
   "unit": "sd",
   "min": -2,
   "max": 2,
   "rest": {
    "F": 0,
    "M": 0
   }
  }
 ],
 "formula": {
  "zh": "ln y = a + bStature*ln(S/1650) + cBmi*ln(B/22) + L1*legLength + L2*centralBuild（系数在 anthro-model.json）；scale = y(控制量)/y(静止)",
  "en": "ln y = a + bStature*ln(S/1650) + cBmi*ln(B/22) + L1*legLength + L2*centralBuild (coefficients in anthro-model.json); scale = y(controls) / y(rest)"
 },
 "segments": [
  {
   "id": "headNeck",
   "name": {
    "zh": "头颈",
    "en": "Head and neck"
   },
   "lengthMm": {
    "stature": 1,
    "cervicaleheight": -1
   }
  },
  {
   "id": "trunk",
   "name": {
    "zh": "躯干（C7 至大转子）",
    "en": "Trunk (C7 to trochanterion)"
   },
   "lengthMm": {
    "cervicaleheight": 1,
    "trochanterionheight": -1
   }
  },
  {
   "id": "thigh",
   "name": {
    "zh": "大腿",
    "en": "Thigh"
   },
   "lengthMm": {
    "trochanterionheight": 1,
    "lateralfemoralepicondyleheight": -1
   }
  },
  {
   "id": "shank",
   "name": {
    "zh": "小腿",
    "en": "Lower leg"
   },
   "lengthMm": {
    "lateralfemoralepicondyleheight": 1,
    "lateralmalleolusheight": -1
   }
  },
  {
   "id": "ankleHeight",
   "name": {
    "zh": "踝高",
    "en": "Ankle height"
   },
